# Optional: path to a legitimate FFmpeg-compatible RNNoise .rnnn model
RNNOISE_MODEL=
# Optional: where to write experiments
TRISHUL_ARTIFACT_DIR=./artifacts
# Optional local MySQL metadata mode; never commit real credentials
DATABASE_URL=

# Docker Compose MySQL example passwords are local-only; replace before use
MYSQL_LOCAL_PASSWORD=local-only-change-me
MYSQL_LOCAL_ROOT_PASSWORD=local-root-change-me
